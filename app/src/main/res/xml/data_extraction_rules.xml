<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- Encrypted API keys: the Keystore key that decrypts them is not backed up or transferred. On-device model
         statistics: measured on this phone. -->
    <cloud-backup>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
        <exclude domain="file" path="datastore/on_device_stats.preferences_pb" />
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
        <exclude domain="file" path="datastore/on_device_stats.preferences_pb" />
    </device-transfer>
</data-extraction-rules>